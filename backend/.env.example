# ─── Core ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/restaurant
# Optional: Redis for caching / sessions. Falls back to in-memory when unavailable.
REDIS_URL=redis://localhost:6379

# ─── Security (use long random strings in production) ─
SESSION_SECRET=change-me
JWT_SECRET=change-me
REFRESH_SECRET_KEY=change-me

# ─── Frontend / CORS ──────────────────────────────────
# Public URL of the frontend. Used for CORS, QR codes, OAuth and email links.
FRONTEND_URL=http://localhost:5173
# Extra allowed origins, comma separated (e.g. a LAN address for testing on phones)
CORS_ORIGINS=

# ─── Guest seating ────────────────────────────────────
# Allow guests to be seated without scanning a QR code ("Get seated now"). Set false to require QR.
ALLOW_WALK_IN=true
# Rotate a table's QR code after every checkout so an old photo/link of it cannot start a new session.
# Only enable if QR codes are shown on screens/tablets that refresh: printed codes would stop working.
ROTATE_QR_ON_CHECKOUT=false

# ─── Billing ──────────────────────────────────────────
# Tax applied on top of menu prices (0.05 = 5% GST). Keep in sync with frontend VITE_TAX_RATE.
TAX_RATE=0.05
# ISO currency for card payments (lowercase). Keep in sync with frontend VITE_CURRENCY.
PAYMENT_CURRENCY=inr

# ─── Stripe (optional: enables "Pay by card") ────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Google OAuth (optional) ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (optional: verification & password reset) ─
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Cloudinary (optional: menu photos; local disk used otherwise) ─
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
