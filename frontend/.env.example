# Backend API base URL (sockets and uploaded images use the same origin)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Public frontend URL encoded into table QR codes.
# Use your LAN IP (e.g. http://192.168.1.20:5173) to scan QR codes from a phone.
VITE_FRONTEND_URL=http://localhost:5173

# Money & tax display (keep in sync with backend TAX_RATE / PAYMENT_CURRENCY)
VITE_CURRENCY=INR
VITE_LOCALE=en-IN
VITE_TAX_RATE=0.05

# Optional: Stripe publishable key enables "Pay by card"
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional: shown on printed guest invoices
VITE_RESTAURANT_GSTIN=
